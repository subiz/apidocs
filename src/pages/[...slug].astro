---
import {render} from 'astro:content';
import {docs,routeSlug,url} from '../lib/docs';
import {docsRedirects} from '../lib/redirects';
import {localeOf} from '../lib/i18n';
import Layout from '../components/Layout.astro';
import DocsRedirect from '../components/DocsRedirect.astro';
export async function getStaticPaths(){
 return [
  ...(await docs()).map(page=>({params:{slug:routeSlug(page.id).replace(/\/$/,'')||undefined},props:{page,redirect:undefined}})),
  ...docsRedirects.map(redirect=>({params:{slug:redirect.slug},props:{page:undefined,redirect}})),
 ];
}
const {page,redirect}=Astro.props;
const rendered=page?await render(page):null;
const Content=rendered?.Content;
---
{redirect?<DocsRedirect destination={url(redirect.pageId)} hash={redirect.hash} locale={localeOf(redirect.pageId)}/>:Content&&<Layout page={page} headings={rendered?.headings}><Content/></Layout>}
